{
  "name": "devisio-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend du SaaS Devisio pour artisans",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "start": "nest start",
    "start:dev": "npm run prisma:generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "format": "prettier --write src prisma.config.ts test README.md",
    "format:check": "prettier --check src prisma.config.ts test README.md",
    "test": "npm run build && node --test test/*.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "prisma": "7.10.0",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
